# Copy only these values into the real backend .env when the API is deployed.
# All credentials, database URLs and JWT keys remain the same as the existing
# environment; never commit their real values.

# ERPNext source system
ERPNEXT_BASE_URL=https://erp.example.com
SITE_URL=https://erp.example.com

# Public HTTPS origin that ERPNext can reach. Do not include a trailing slash.
PUBLIC_WEBHOOK_BASE_URL=https://biddingflow.example.com

# Browser origin allowed by FastAPI CORS. Use commas for multiple origins.
FRONTEND_ORIGINS=https://biddingflow.example.com

# Switch MR/SQ/purchase-document discovery from continuous polling to webhook.
# A one-time reconciliation still runs whenever the API starts.
MR_INGEST_MODE=webhook

# These are fallback/recovery intervals when polling mode is selected again.
MR_POLL_INTERVAL_SECONDS=5
MR_FULL_RECONCILE_INTERVAL_SECONDS=30
PURCHASE_DOCUMENT_POLL_INTERVAL_SECONDS=15
QUOTATION_POLL_INTERVAL_SECONDS=10
ITEM_POLL_INTERVAL_SECONDS=15

# Keep the existing secret value on both sides. Rotate it if it was exposed.
ERPNEXT_WEBHOOK_SECRET=REPLACE_WITH_A_LONG_RANDOM_VALUE
