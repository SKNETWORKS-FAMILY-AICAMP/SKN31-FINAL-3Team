[Unit]
Description=BiddingFlow RFQ reminder job
After=network-online.target biddingflow-api.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/biddingflow/backend
EnvironmentFile=/opt/biddingflow/backend/.env
ExecStart=/opt/biddingflow/backend/.venv/bin/python -m backend_logic2.jobs.rfq_reminder_job
