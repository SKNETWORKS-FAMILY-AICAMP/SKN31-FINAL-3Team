# Public HTTPS reverse proxy used while the kro.kr certificate is rate-limited.
# Install only after Certbot has created the referenced certificate files.
server {
    listen 80;
    listen [::]:80;
    server_name biddingflow.kro.kr;

    # Keep this available so a biddingflow.kro.kr certificate can be issued
    # later without stopping Nginx.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Temporary redirect; use 302 so browsers do not cache it after kro.kr
    # receives its own certificate.
    location / {
        return 302 https://biddingflow.13.209.103.102.nip.io$request_uri;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name biddingflow.13.209.103.102.nip.io;

    # Certbot renews through this path without stopping Nginx.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name biddingflow.13.209.103.102.nip.io;

    ssl_certificate /etc/letsencrypt/live/biddingflow.13.209.103.102.nip.io/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/biddingflow.13.209.103.102.nip.io/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:BiddingFlowTLS:10m;
    ssl_session_tickets off;

    root /var/www/biddingflow/current;
    index index.html;

    access_log /var/log/nginx/biddingflow-access.log;
    error_log /var/log/nginx/biddingflow-error.log;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location /api/procurement/events {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /purchase/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /deployment-status.json {
        alias /var/www/biddingflow/deployment-status.json;
        add_header Cache-Control "no-store";
    }

    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
