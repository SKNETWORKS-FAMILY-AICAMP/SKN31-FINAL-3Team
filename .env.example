# ERPNext login and automation
ERPNEXT_BASE_URL=http://13.209.103.102:8080
SITE_URL=http://13.209.103.102:8080
API_KEY=
API_SECRET=

# PostgreSQL authentication store (backend service/migrations)
DATABASE_URL=postgresql://nexterp:CHANGE_ME@13.209.103.102:15432/nexterp

# PostgreSQL procurement store (small-team shared development superuser)
# Prefer an SSH tunnel and 127.0.0.1:15433 when possible.
NEXTERP_DATABASE_URL=postgresql://nexterp:CHANGE_ME@13.209.103.102:15432/nexterp?sslmode=disable

# Local access JWT and server-side session encryption
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ALGORITHM=HS256
JWT_ISSUER=biddingflow-auth
JWT_AUDIENCE=authenticated
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_ENCRYPTION_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_KEY

# ERPNext Client Script / Webhook authentication (use different random values)
CLIENT_SCRIPT_SECRET=REPLACE_WITH_CLIENT_SCRIPT_SECRET
ERPNEXT_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET
FRONTEND_ORIGINS=http://localhost:5173
PROCUREMENT_API_BASE_URL=http://127.0.0.1:8000
# ERPNext가 접근할 수 있는 공개 FastAPI 주소. 로컬 quick tunnel은
# webhook-dev.bat이 일시적으로 주입하므로 비워둘 수 있습니다.
PUBLIC_WEBHOOK_BASE_URL=

# Local/shared-network development: polling
# Deployed backend reachable by ERPNext: webhook
MR_INGEST_MODE=polling
MR_POLL_INTERVAL_SECONDS=5
# polling 모드에서 기존 MR의 필드/첨부파일까지 다시 대사하는 주기
MR_FULL_RECONCILE_INTERVAL_SECONDS=30
PURCHASE_DOCUMENT_POLL_INTERVAL_SECONDS=15
QUOTATION_POLL_INTERVAL_SECONDS=10
ITEM_POLL_INTERVAL_SECONDS=15

# Outbound email policy:
# true        = block every real email (safe default)
# custom_only = send RFQ, PR, PO and reminder email only to exact addresses in
#               EMAIL_RECIPIENT_ALLOWLIST (fail closed when the list is empty)
# false       = send normal production email to every selected recipient
TEST_MODE=true
# Preferred: JSON file read at each send, so editing it needs no service restart.
# Production example: /etc/biddingflow/email-recipient-allowlist.json
EMAIL_RECIPIENT_ALLOWLIST_PATH=
# Backward-compatible fallback when no JSON path/file is configured.
# Comma/semicolon-separated exact mailbox addresses. No domain wildcards.
EMAIL_RECIPIENT_ALLOWLIST=

# External AI/search services
OPENAI_API_KEY=

# Read-only feature guide and procurement status assistant
ASSISTANT_ENABLED=true
ASSISTANT_MODEL=gpt-5.6-luna
ASSISTANT_REASONING_EFFORT=medium
ASSISTANT_MAX_OUTPUT_TOKENS=1200
ASSISTANT_TIMEOUT_SECONDS=25
# Optional overrides. Defaults point to version-controlled JSON sources and
# .runtime/assistant/help.sqlite3 for the generated local FTS index.
ASSISTANT_FEATURE_CATALOG_PATH=
ASSISTANT_HELP_SOURCE_PATH=
ASSISTANT_HELP_DB_PATH=
ASSISTANT_ALLOW_MUTATIONS=false
TAVILY_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Prevent real outbound email during development
TEST_RECIPIENT_OVERRIDE=



# Quotation extraction provider used by ERPNext inbound-email webhooks.
# Python extracts DOCX/Excel/CSV/TXT/EML locally; Qwen3.5-9B inference runs on RunPod.
QUOTATION_EXTRACTOR_PROVIDER=runpod
RUNPOD_QUOTATION_ENDPOINT_ID=
RUNPOD_API_KEY=
# Enable only after migration 015 + independent lease safety timer installation.
RUNPOD_ADMIN_CONTROL_ENABLED=false
# Optional separate key with RunPod endpoint-management permission (server only).
RUNPOD_CONTROL_API_KEY=
# Enable after the worker release supports input.warmup=true.
RUNPOD_ADMIN_WARMUP_ENABLED=false
RUNPOD_QUOTATION_TIMEOUT_SECONDS=600
RUNPOD_QUOTATION_POLL_INTERVAL_SECONDS=2
RUNPOD_QUOTATION_CONNECT_TIMEOUT_SECONDS=10
RUNPOD_QUOTATION_REQUEST_TIMEOUT_SECONDS=60
RUNPOD_QUOTATION_MAX_DOCUMENT_BYTES=6291456
RUNPOD_QUOTATION_MAX_PAYLOAD_BYTES=9437184
RUNPOD_QUOTATION_MAX_TEXT_CHARS=60000
RUNPOD_QUOTATION_MAX_DOCUMENTS=8
RUNPOD_QUOTATION_MAX_NEW_TOKENS=512
RUNPOD_QUOTATION_STATUS_MAX_ATTEMPTS=3
RUNPOD_QUOTATION_PROMPT_VERSION=qwen35-quotation-text-json-v1
RUNPOD_QUOTATION_PIPELINE_VERSION=document-text-v1
# Public server: webhook. Local development without a public URL: polling.
RUNPOD_QUOTATION_DELIVERY_MODE=polling
RUNPOD_QUOTATION_WEBHOOK_URL=



# Quotation ranking: deterministic price/delivery + semantic specification fit.
# Production defaults to RunPod Qwen. Set luna only for controlled benchmark runs;
# there is no implicit fallback that sends confidential quotation data to OpenAI.
QUOTATION_SPEC_PROVIDER=runpod
RUNPOD_SPEC_ENDPOINT_ID=
RUNPOD_SPEC_CACHE_VERSION=v1
RUNPOD_SPEC_MODEL_NAME=qwen3.5-9b-4bit
# Submit a 10-quotation batch up front. RunPod endpoint Max workers controls GPU concurrency.
RUNPOD_SPEC_PARALLEL_JOBS=10
RUNPOD_SPEC_TIMEOUT_SECONDS=360
RUNPOD_SPEC_POLL_INTERVAL_SECONDS=2
RUNPOD_SPEC_CONNECT_TIMEOUT_SECONDS=10
RUNPOD_SPEC_REQUEST_TIMEOUT_SECONDS=60
RUNPOD_SPEC_MAX_NEW_TOKENS=900
RUNPOD_SPEC_RETRY_MAX_NEW_TOKENS=1024
RUNPOD_SPEC_MAX_ATTEMPTS=2
RUNPOD_SPEC_PROMPT_VERSION=qwen35-spec-eval-v1
RUNPOD_SPEC_PIPELINE_VERSION=document-text-v1
# RunPod worker environment must set MAX_NEW_TOKENS_CAP >= 1024.
# Luna benchmark-only settings:
QUOTATION_SPEC_MODEL=gpt-5.6-luna
QUOTATION_SPEC_REASONING_EFFORT=medium
QUOTATION_SPEC_TIMEOUT_SECONDS=60
QUOTATION_SPEC_MAX_OUTPUT_TOKENS=4000
  # CLI/direct-call fallback weights. Production workflows use the versioned
  # weights published from the admin policy page and pinned to each MR.
  # Ratios (0.6/0.4) and percentages (60/40) are both valid here.
QUOTATION_NUMERIC_SCORE_WEIGHT=0.6
QUOTATION_SPEC_SCORE_WEIGHT=0.4
# Public HTTPS origin used in supplier PR acceptance/rejection email links.
BIDDINGFLOW_PUBLIC_URL=http://localhost:8000
# Optional safe-test recipient. Leave empty in production.
PR_EMAIL_OVERRIDE=
