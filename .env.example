# ERPNext login and automation
ERPNEXT_BASE_URL=http://13.209.103.102:8080
SITE_URL=http://13.209.103.102:8080
API_KEY=
API_SECRET=

# PostgreSQL authentication store (backend service/migrations)
DATABASE_URL=postgresql://nexterp:CHANGE_ME@13.209.103.102:15432/nexterp

# PostgreSQL procurement store (small-team shared development superuser)
# Prefer an SSH tunnel and 127.0.0.1:15433 when possible.
NEXTERP_DATABASE_URL=postgresql://nexterp:CHANGE_ME@13.209.103.102:15432/nexterp?sslmode=disable

# Local access JWT and server-side session encryption
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ALGORITHM=HS256
JWT_ISSUER=biddingflow-auth
JWT_AUDIENCE=authenticated
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_ENCRYPTION_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_KEY

# External AI/search services
OPENAI_API_KEY=
TAVILY_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Prevent real outbound email during development
TEST_RECIPIENT_OVERRIDE=


HF_QUOTATION_TEXT_MODEL=Qwen/Qwen3-0.6B
HF_QUOTATION_VISION_MODEL=Qwen/Qwen2-VL-2B-Instruct
HF_QUOTATION_MAX_NEW_TOKENS=768
HF_QUOTATION_VISION_MAX_NEW_TOKENS=256
HF_QUOTATION_VISION_MAX_PIXELS=1003520
